HOST=0.0.0.0
PORT=3000
NODE_ENV=development
# Required for a public deployment. Comma-separated exact origins, no trailing slash.
# ALLOWED_ORIGINS=https://shelf.example.com
# Only enable behind a reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
SESSION_TTL_SECONDS=1800
INVITE_TTL_SECONDS=600
MAX_SESSIONS=2000
MAX_FILE_BYTES=2147483648
STUN_URLS=stun:stun.cloudflare.com:3478
# Production: use your own TURN server with expiring HMAC credentials.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# TURN_SECRET=replace-with-a-long-random-secret
ICE_TRANSPORT_POLICY=all
# Docker Compose HTTPS deployment only: DNS name without https://.
# SHELF_DOMAIN=shelf.example.com
