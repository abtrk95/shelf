# Starting template for a separately operated coturn server; NOT auto-deployed.
# Replace every placeholder, provide working certificates, and review your firewall.
# The secret must exactly match the app's TURN_SECRET. Do not commit the real file.
# Reference: https://github.com/coturn/coturn/blob/master/examples/etc/turnserver.conf
listening-port=3478
tls-listening-port=5349
min-port=49160
max-port=49260
realm=turn.example.com
server-name=turn.example.com
fingerprint
use-auth-secret
static-auth-secret=REPLACE_WITH_A_LONG_RANDOM_SECRET
cert=/etc/letsencrypt/live/turn.example.com/fullchain.pem
pkey=/etc/letsencrypt/live/turn.example.com/privkey.pem
# Set when behind NAT; public/private addresses must map the relay ports 1:1.
# external-ip=YOUR_PUBLIC_IP/YOUR_PRIVATE_IP
no-multicast-peers
no-cli
user-quota=12
total-quota=200
# Starting limits in bytes/second; tune to capacity, concurrent use and budget.
max-bps=10485760
bps-capacity=104857600
# Block private/loopback/link-local/cloud-metadata destinations.
# Keep default loopback restrictions enabled; never add allow-loopback-peers.
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff
# Also enforce egress restrictions at the OS/cloud firewall, including mapped IPv6
# private addresses and your own internal networks. Review logging/retention.
